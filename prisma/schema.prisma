generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String // Hashed
  role     String @default("admin") // Only admin role exists for now
  createdAt DateTime @default(now())
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  documents Document[]
}

model Document {
  id String @id @default(cuid())
  title String
  content String? // Nullable for binary files (PDF etc)
  fileType String // 'md', 'html', 'pdf', 'url' etc
  filePath String? // Path to uploaded file (public/uploads/...)
  externalUrl String? // For external links
  fileSize Int? // In bytes
  
  requiredRole String @default("VIEWER") // 'ADMIN', 'EDITOR', 'VIEWER'

  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
